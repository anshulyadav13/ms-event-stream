{
  "name": "ms-event-stream",
  "version": "1.0.0",
  "description": "A NestJS package that provides a plug-and-play event system for microservices with outbox/inbox patterns, Redis streams, and reliable event processing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "ts-node src/index.ts",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "cli": "ts-node src/cli/main.ts",
    "cli:build": "tsc && node dist/cli/main.js"
  },
  "keywords": [
    "nestjs",
    "events",
    "microservices",
    "outbox",
    "inbox",
    "redis",
    "streams",
    "event-driven",
    "deduplication",
    "reliability"
  ],
  "author": "ms-event-stream",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anshulyadav13/ms-event-stream.git"
  },
  "bugs": {
    "url": "https://github.com/anshulyadav13/ms-event-stream/issues"
  },
  "homepage": "https://github.com/anshulyadav13/ms-event-stream#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "ms-event-stream-cli": "dist/cli/main.js"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.0",
    "@types/pg": "^8.10.7",
    "@types/uuid": "^9.0.5",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.49.0",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/*.interface.ts"
    ]
  }
}
